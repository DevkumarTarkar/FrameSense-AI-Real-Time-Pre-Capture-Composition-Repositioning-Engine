'use client'

import { useState } from 'react'
import { Aperture, Camera, Check, ChevronDown, CircleHelp, Crosshair, Grid3X3, History, LayoutDashboard, LockKeyhole, Mic2, MoreHorizontal, Play, RotateCcw, Settings2, Sparkles, Target, Video, Volume2, WandSparkles, Zap } from 'lucide-react'

const checks = [
  { label: 'Rule of thirds', value: '92%', width: '92%', tone: 'lime' },
  { label: 'Headroom', value: 'Optimal', width: '88%', tone: 'cyan' },
  { label: 'Horizon level', value: '1.2°', width: '96%', tone: 'lime' },
  { label: 'Subject distance', value: 'Good', width: '79%', tone: 'amber' },
]

export default function Page() {
  const [recording, setRecording] = useState(false)
  const [voice, setVoice] = useState(true)
  const [grid, setGrid] = useState(true)
  const [captured, setCaptured] = useState(false)

  return (
    <main className="min-h-screen bg-[#070a0d] text-[#f4f7f4] selection:bg-[#d9ff5b] selection:text-[#10150d]">
      <header className="flex h-[76px] items-center justify-between border-b border-white/[.08] px-5 lg:px-9">
        <div className="flex items-center gap-3.5"><div className="flex h-10 w-10 items-center justify-center rounded-xl bg-[#d9ff5b] text-[#0b1008] shadow-[0_0_30px_rgba(217,255,91,.14)]"><Aperture size={21} /></div><div><div className="flex items-center gap-2 text-[15px] font-semibold tracking-[-.03em]">FrameSense <span className="rounded-full bg-[#d9ff5b]/15 px-2 py-0.5 text-[9px] font-bold tracking-[.16em] text-[#d9ff5b]">AI</span></div><div className="mt-0.5 text-[9px] uppercase tracking-[.2em] text-[#6c777a]">Real-time composition intelligence</div></div></div>
        <div className="flex items-center gap-3"><div className="hidden items-center gap-2 rounded-full border border-[#d9ff5b]/20 bg-[#d9ff5b]/[.06] px-3 py-1.5 text-[10px] uppercase tracking-[.12em] text-[#badb7b] sm:flex"><span className="h-1.5 w-1.5 rounded-full bg-[#d9ff5b] shadow-[0_0_9px_#d9ff5b]" /> Engine online</div><button className="rounded-xl border border-white/10 p-2.5 text-[#849093] transition hover:border-white/25 hover:text-white" aria-label="Settings"><Settings2 size={16} /></button><div className="hidden h-8 w-8 items-center justify-center rounded-full bg-[#1d2926] text-[11px] font-semibold text-[#d9ff5b] sm:flex">DK</div></div>
      </header>
      <div className="mx-auto flex max-w-[1550px] gap-7 px-4 py-6 sm:px-6 lg:px-9">
        <aside className="hidden w-[185px] shrink-0 flex-col justify-between xl:flex"><div><div className="mb-7 px-3 text-[10px] uppercase tracking-[.18em] text-[#536064]">Workspace</div><nav className="space-y-1"><Nav active icon={<LayoutDashboard size={16} />} label="Live monitor" /><Nav icon={<History size={16} />} label="Session history" /><Nav icon={<Sparkles size={16} />} label="Model insights" /></nav><div className="my-8 h-px bg-white/[.07]" /><div className="px-3 text-[10px] uppercase tracking-[.18em] text-[#536064]">Connected camera</div><div className="mt-3 rounded-2xl border border-white/[.08] bg-[#101619] p-3.5"><div className="mb-3 flex items-center gap-2"><span className="h-2 w-2 rounded-full bg-[#d9ff5b]" /><span className="text-xs text-[#dbe3df]">Camera 01</span></div><div className="text-[10px] text-[#657277]">Sony Alpha A7 IV</div><div className="mt-2 font-mono text-[10px] text-[#8d9a9c]">1080p / 30 FPS</div></div></div><div className="rounded-2xl border border-white/[.07] p-3.5 text-[10px] leading-relaxed text-[#637075]"><CircleHelp className="mb-2 text-[#8a9999]" size={15} />Need help? View the quick start guide.</div></aside>
        <section className="min-w-0 flex-1"><div className="mb-6 flex items-end justify-between"><div><div className="mb-2 flex items-center gap-2 text-[10px] uppercase tracking-[.2em] text-[#718083]">Portrait studio <ChevronDown size={12} /></div><h1 className="text-[28px] font-medium tracking-[-.055em] text-white sm:text-[35px]">Live monitor <span className="text-[#4b575b]">/</span> <span className="text-[#849094]">composition check</span></h1></div><div className="hidden items-center gap-2 rounded-full border border-white/[.08] px-3 py-2 text-[10px] text-[#778487] sm:flex"><LockKeyhole size={12} /> Private session</div></div>
          <div className="grid gap-5 2xl:grid-cols-[minmax(0,1fr)_360px]"><div className="min-w-0"><div className="relative aspect-[16/10] min-h-[360px] overflow-hidden rounded-[24px] border border-white/[.12] bg-[#21302e] shadow-2xl shadow-black/50"><div className="absolute inset-0 bg-[radial-gradient(ellipse_at_63%_28%,rgba(238,231,205,.78),transparent_17%),linear-gradient(120deg,#1b302e_0%,#59746d_39%,#b6ad94_70%,#3c3f3d_100%)]" /><div className="absolute inset-0 bg-[linear-gradient(90deg,rgba(4,10,11,.55),transparent_42%,rgba(7,12,13,.18)),linear-gradient(0deg,rgba(5,10,10,.65),transparent_32%,rgba(5,10,10,.08))]" /><div className="absolute left-[55%] top-[17%] h-[61%] w-[25%] rounded-[48%_48%_24%_24%] bg-[radial-gradient(ellipse_at_50%_18%,#b9977b,#73594f_25%,#30292c_27%,#242226_61%,#172021)] opacity-95 shadow-[28px_28px_38px_rgba(10,18,15,.35)]" /><div className="absolute left-[62%] top-[30%] h-3 w-3 rounded-full bg-[#121819] shadow-[28px_0_0_#121819]" /><div className="absolute left-[60%] top-[39%] h-1 w-10 -rotate-3 rounded-full bg-[#1b1819] opacity-80" />{grid && <div className="pointer-events-none absolute inset-0 bg-[linear-gradient(to_right,transparent_33.15%,rgba(217,255,91,.43)_33.3%,transparent_33.45%,transparent_66.5%,rgba(217,255,91,.43)_66.65%,transparent_66.8%),linear-gradient(to_bottom,transparent_33.15%,rgba(217,255,91,.43)_33.3%,transparent_33.45%,transparent_66.5%,rgba(217,255,91,.43)_66.65%,transparent_66.8%)]" />}<div className="absolute left-[65%] top-[30%] h-[29%] w-[13%] rounded border border-[#d9ff5b] shadow-[0_0_22px_rgba(217,255,91,.25)]"><span className="absolute -left-px -top-5 rounded bg-[#d9ff5b] px-2 py-1 text-[9px] font-bold uppercase tracking-wider text-[#10150d]">Face 96%</span></div><div className="absolute inset-0 flex items-center justify-center"><Crosshair className="text-white/55" size={34} strokeWidth={1} /></div><div className="absolute inset-x-0 top-0 flex items-center justify-between p-5 text-[9px] font-mono uppercase tracking-[.15em] text-white/70"><span className="flex items-center gap-2"><span className="h-1.5 w-1.5 animate-pulse rounded-full bg-[#ff6d6d]" /> LIVE FEED</span><span>24mm · f/2.8 · ISO 400</span></div><div className="absolute bottom-0 inset-x-0 flex items-end justify-between bg-gradient-to-t from-black/70 to-transparent px-5 pb-5 pt-14"><div><div className="mb-1 text-[10px] uppercase tracking-[.16em] text-[#d9ff5b]">Move subject slightly left</div><div className="text-sm text-white">Aligning with the vertical power line</div></div><div className="rounded-lg border border-white/15 bg-black/25 px-2.5 py-2 text-[9px] text-white/70">AI OVERLAY ON</div></div></div><div className="mt-3 flex flex-wrap items-center justify-between gap-3"><div className="flex items-center gap-2"><button onClick={() => setRecording(!recording)} className={`flex items-center gap-2 rounded-xl px-4 py-2.5 text-[11px] font-semibold transition ${recording ? 'bg-[#ff6868] text-white' : 'bg-[#d9ff5b] text-[#10150d] hover:bg-[#e4ff87]'}`}><span className={`h-2 w-2 rounded-full ${recording ? 'bg-white' : 'bg-[#10150d]'}`} />{recording ? 'Stop recording' : 'Start recording'}</button><button onClick={() => setCaptured(true)} className="flex items-center gap-2 rounded-xl border border-white/10 bg-white/[.04] px-4 py-2.5 text-[11px] text-[#c3ceca] transition hover:bg-white/[.08]"><Camera size={14} /> Capture frame</button></div><div className="flex items-center gap-2"><ToolButton active={grid} onClick={() => setGrid(!grid)} label="Grid" icon={<Grid3X3 size={14} />} /><ToolButton active={voice} onClick={() => setVoice(!voice)} label="Voice" icon={voice ? <Volume2 size={14} /> : <Mic2 size={14} />} /><button className="rounded-xl border border-white/10 p-2.5 text-[#839093] hover:bg-white/[.06]" aria-label="Reset"><RotateCcw size={14} /></button></div></div></div>
            <aside className="space-y-4"><div className="rounded-[22px] border border-white/[.1] bg-[#101619] p-5"><div className="mb-5 flex items-start justify-between"><div><div className="mb-1 flex items-center gap-2 text-[10px] uppercase tracking-[.17em] text-[#839094]"><Target size={14} className="text-[#d9ff5b]" /> Composition score</div><p className="text-[11px] text-[#59676b]">Real-time scene assessment</p></div><MoreHorizontal size={17} className="text-[#667479]" /></div><div className="flex items-center gap-5"><div className="relative flex h-32 w-32 shrink-0 items-center justify-center rounded-full border-[8px] border-[#26352c]"><div className="absolute inset-[-8px] rounded-full border-[8px] border-transparent border-l-[#d9ff5b] border-t-[#d9ff5b] rotate-[34deg]" /><div className="text-center"><div className="text-[42px] font-light leading-none tracking-[-.1em] text-white">88</div><div className="mt-1 text-[9px] uppercase tracking-widest text-[#778487]">out of 100</div></div></div><div><div className="mb-1 text-[11px] font-semibold uppercase tracking-[.12em] text-[#d9ff5b]">Strong composition</div><p className="text-[11px] leading-relaxed text-[#8b999b]">Subject is balanced and ready. One small adjustment can make this frame stronger.</p></div></div></div><div className="rounded-[22px] border border-white/[.1] bg-[#101619] p-5"><div className="mb-5 flex items-center justify-between"><span className="text-[10px] uppercase tracking-[.17em] text-[#839094]">Geometric engine</span><span className="flex items-center gap-1 text-[10px] text-[#d9ff5b]"><Zap size={12} /> Active</span></div><div className="space-y-4">{checks.map((check) => <div key={check.label}><div className="mb-2 flex justify-between text-[11px]"><span className="text-[#aebbbb]">{check.label}</span><span className={check.tone === 'amber' ? 'text-[#edbb60]' : check.tone === 'cyan' ? 'text-[#71e3df]' : 'text-[#d9ff5b]'}>{check.value}</span></div><div className="h-1.5 overflow-hidden rounded-full bg-white/[.08]"><div className={`h-full rounded-full ${check.tone === 'amber' ? 'bg-[#edbb60]' : check.tone === 'cyan' ? 'bg-[#71e3df]' : 'bg-[#d9ff5b]'}`} style={{ width: check.width }} /></div></div>)}</div></div><div className="rounded-[22px] border border-[#d9ff5b]/20 bg-[#d9ff5b]/[.06] p-5"><div className="mb-3 flex items-center gap-2 text-[10px] uppercase tracking-[.17em] text-[#d9ff5b]"><WandSparkles size={14} /> Smart suggestion</div><p className="text-[13px] leading-relaxed text-[#dce7d0]">Shift the subject <strong className="font-semibold text-white">8–12 cm left</strong> to create a cleaner leading space.</p><button className="mt-4 flex items-center gap-2 text-[10px] uppercase tracking-[.14em] text-[#d9ff5b] hover:text-white">Show movement guide <Play size={11} fill="currentColor" /></button></div></aside></div>
          <div className="mt-5 grid gap-4 md:grid-cols-3"><Metric icon={<Sparkles size={14} className="text-[#d9ff5b]" />} title="Neural aesthetic" meta="NIMA / MobileNetV3"><div className="flex items-end gap-2"><span className="text-3xl font-light">8.4</span><span className="mb-1 text-xs text-[#697579]">/ 10.0</span><span className="mb-1 ml-auto text-[10px] text-[#d9ff5b]">+0.6</span></div><div className="mt-4 flex h-8 items-end gap-1">{[28,35,31,42,49,45,59,56,68,61,72,78,76,88,84,91,86,94].map((h, i) => <span key={i} className="flex-1 rounded-sm bg-[#d9ff5b]" style={{ height: `${h}%`, opacity: .3 + i / 28 }} />)}</div></Metric><Metric icon={<span className="inline-flex h-3.5 w-3.5 rounded-full border-2 border-[#edbb60]" />} title="Scene conditions"><div className="grid grid-cols-2 gap-4"><div><div className="text-2xl font-light">5200<span className="text-sm text-[#697579]">K</span></div><div className="mt-1 text-[10px] text-[#697579]">Color temperature</div></div><div><div className="text-2xl font-light">72<span className="text-sm text-[#697579]">%</span></div><div className="mt-1 text-[10px] text-[#697579]">Key light balance</div></div></div></Metric><Metric icon={<Video size={14} className="text-[#71e3df]" />} title="Session status"><div className="flex items-center justify-between"><div><div className="text-sm text-white">{captured ? 'Frame captured' : recording ? 'Recording in progress' : 'Ready to capture'}</div><div className="mt-1 text-[10px] text-[#697579]">{captured ? 'Analysis saved to session' : 'No frame captured yet'}</div></div><span className="flex h-8 w-8 items-center justify-center rounded-full bg-[#d9ff5b]/10 text-[#d9ff5b]">{captured ? <Check size={15} /> : <Play size={14} fill="currentColor" />}</span></div></Metric></div>
          <footer className="mt-6 flex flex-wrap justify-between gap-3 border-t border-white/[.08] py-4 text-[9px] uppercase tracking-[.15em] text-[#59666a]"><span className="flex items-center gap-2"><LockKeyhole size={12} /> Explainable pre-capture feedback</span><span className="flex gap-4"><span>MediaPipe</span><span>OpenCV</span><span>NIMA</span></span></footer>
        </section>
      </div>
    </main>
  )
}

function Nav({ icon, label, active = false }: { icon: React.ReactNode; label: string; active?: boolean }) { return <button className={`flex w-full items-center gap-3 rounded-xl px-3 py-3 text-left text-[12px] transition ${active ? 'bg-[#d9ff5b] font-medium text-[#10150d]' : 'text-[#738085] hover:bg-white/[.04] hover:text-white'}`}>{icon}{label}</button> }
function ToolButton({ active, onClick, label, icon }: { active: boolean; onClick: () => void; label: string; icon: React.ReactNode }) { return <button onClick={onClick} className={`flex items-center gap-2 rounded-xl border px-3 py-2.5 text-[10px] transition ${active ? 'border-[#d9ff5b]/30 bg-[#d9ff5b]/10 text-[#d9ff5b]' : 'border-white/10 text-[#697579]'}`}>{icon}{label}</button> }
function Metric({ icon, title, meta, children }: { icon: React.ReactNode; title: string; meta?: string; children: React.ReactNode }) { return <div className="rounded-[20px] border border-white/[.1] bg-[#101619] p-4"><div className="mb-4 flex items-center justify-between text-[10px] uppercase tracking-[.16em] text-[#839094]"><span className="flex items-center gap-2">{icon}{title}</span>{meta && <span className="text-[9px] tracking-normal text-[#5f6d70]">{meta}</span>}</div>{children}</div> }
