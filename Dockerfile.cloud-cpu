# FrameSense AI - Production Cloud CPU Container (Render / Railway / AWS EC2)
# Ultra-lightweight ~650MB image with sub-2-minute build time
FROM python:3.11-slim

# Install system dependencies required for OpenCV and MediaPipe headless
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy CPU requirements and install
COPY backend/requirements-cpu.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r ./backend/requirements.txt

# Copy source code
COPY backend ./backend
COPY ai_engine ./ai_engine
COPY ml_model ./ml_model
RUN mkdir -p /app/data/uploads

# Set python path and unbuffered logging
ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV PORT=8000

# Expose default port
EXPOSE 8000

# Healthcheck for cloud load balancers
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/health || exit 1

# Start uvicorn binding to 0.0.0.0 and dynamic cloud PORT
CMD ["sh", "-c", "uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
